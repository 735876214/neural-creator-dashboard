# 通用构建：NAS 上 compose 直接用 GitHub 仓库地址作为构建上下文时使用。
# 与根目录 Dockerfile 的差别：多阶段 —— 第一阶段构建前端 dist/，
# 最终镜像自带看板静态页并由 note-api 托管（STATIC_DIR），无需 nginx。
#
# 构建上下文 = 仓库根（compose: build.context 指向 GitHub 地址时即是）。
# syntax 行让 Docker 在拉取远端上下文时也能解析多阶段与缓存挂载。
# syntax=docker/dockerfile:1
FROM node:24-alpine AS web
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm install --no-audit --no-fund
COPY . .
RUN npm run build

FROM node:24-alpine
# VAULT_GIT=1 时 note-api 会调用 git 做自动提交；一并配置 safe.directory 与提交身份
RUN apk add --no-cache git \
 && git config --system --add safe.directory /vault \
 && git config --system user.name "note-api" \
 && git config --system user.email "note-api@localhost"

WORKDIR /app
COPY server ./server
COPY --from=web /app/dist ./dist

ENV NODE_ENV=production \
    PORT=8787 \
    HOST=0.0.0.0 \
    STATIC_DIR=/app/dist \
    VAULT_DIR=/vault \
    DATA_DIR=/data

EXPOSE 8787

HEALTHCHECK --interval=30s --timeout=3s --start-period=5s \
  CMD node -e "fetch('http://127.0.0.1:'+(process.env.PORT||8787)+'/api/health').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"

CMD ["node", "server/index.mjs"]
