# 复制为 .env 并填写。.env 已被 .gitignore 忽略，不要提交。

# —— AI（可选）：不填 = 看板没有 AI 区块，其余功能全部正常 ——
# chat 模型（DeepSeek / 通义兼容模式 / Kimi / 硅基流动…）
AI_API_KEY=
AI_BASE_URL=https://api.deepseek.com/v1
AI_MODEL=deepseek-chat

# embedding（语义关联与向量检索用；DeepSeek 没有这个接口，可用硅基流动的 bge-m3）
EMBED_API_KEY=
EMBED_BASE_URL=https://api.siliconflow.cn/v1
EMBED_MODEL=BAAI/bge-m3

# —— 访问控制 ——
# note-api 的 Bearer token（nginx 会转发浏览器的请求；设了之后前端 fetch 需带 token，
# 简单部署可以留空、只靠 nginx Basic Auth）
API_TOKEN=

# Tailscale 首次授权 key（https://login.tailscale.com/admin/authkeys）
TS_AUTHKEY=
