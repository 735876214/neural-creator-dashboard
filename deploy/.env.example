# 部署环境变量模板：在 deploy/ 目录复制为 .env 后填写
#   cp .env.example .env
# .env 已被 .gitignore 忽略，不要提交。
#
# .env 是可选的：docker compose 会自动读取本目录的 .env 并填充 compose 里的 ${VAR}；
# 没有 .env 也能启动（AI / 热点关闭）。下面所有未注释的变量都会生效；
# 注释掉的行表示使用服务端默认值。

# —— 基础（一般不用改）——
# HOST=0.0.0.0
# PORT=8787
# 宿主机上映射的端口（只绑 127.0.0.1，供本机调试）
# NOTE_API_PORT=8787
# 看板对外端口；被占用时改成别的
# WEB_PORT=8088
# 请求体上限（字节），默认 4194304（4 MB），与 nginx client_max_body_size 4m 对齐
# MAX_BODY=4194304
# vault 是 git 仓库时每次写入自动 commit（误写可回滚）；0 关闭
# VAULT_GIT=1

# —— 登录（必看）——
# 看板使用自己的登录页（login.html），用户名默认 admin。
# 密码留空 = 首次启动随机生成，用 `docker compose logs auth` 查看；
# 想固定密码就填在这里（改完执行 docker compose up -d --force-recreate auth note-api）。
DASHBOARD_USER=admin
DASHBOARD_PASSWORD=
# 登录状态保留天数（Cookie）
# SESSION_DAYS=30

# API_TOKEN 只用于 curl / 脚本等非浏览器客户端；设置后看板的 fetch 不会携带它，
# 读取和保存会返回 401。看板部署请保持注释。
# API_TOKEN=

# —— AI（可选）——
# 不填 AI_API_KEY = 看板没有 AI 区块，其余功能全部正常。
# chat 模型（DeepSeek / 通义兼容模式 / Kimi / 硅基流动 / 自建网关…）
AI_API_KEY=
AI_BASE_URL=https://api.deepseek.com/v1
AI_MODEL=deepseek-chat

# 协议：openai（默认）或 anthropic（走 Anthropic 兼容网关）
# AI_PROTOCOL=openai
# 单次调用超时（毫秒）与并发数
# AI_TIMEOUT=60000
# AI_CONCURRENCY=4

# 各任务可用单独的模型（缺省回落 AI_MODEL）：
# AI_MODEL_ASK=        问答
# AI_MODEL_ANALYZE=    打标签 + 摘要
# AI_MODEL_IDEAS=      选题生成
# AI_MODEL_NEWS=       AI 热点日报
# 前端对话框里也可以随时手动切换模型（选择写在 NAS 的 vault/.dashboard/settings.json）

# —— 网页剪藏（第七星座：个人知识库）——
# 抓取网页的超时（毫秒）与响应体上限（字节）；剪藏页面会存 HTML 快照到 06-个人知识库/.snapshots/
# WEB_FETCH_TIMEOUT=20000
# WEB_FETCH_MAX_BYTES=2097152
# JS 渲染的页面（SPA）抓到的只是空壳，正文可能为空；静态文章页与多数推文页没有问题。
# AI 助手上传文件的上限即 MAX_BODY（默认 4 MB，与 nginx client_max_body_size 对齐），
# 支持 md / txt / docx / pdf（PDF 解析用 pdfjs-dist，纯 JS；docx 为内置 zip 解析，零依赖）。

# —— AI 热点（第六星座）：消费现成 RSS 源 + AI 汇总，每天一份 ——
# RSS 源（默认 AIHOT 的「全部 AI 动态」）
# NEWS_SOURCE=https://aihot.news/feed/all.xml
# 当天几点之后开始生成（0–23，默认 8）
NEWS_HOUR=8
# 设为 0 关闭定时任务
# NEWS_CRON=0

# —— embedding（语义关联与向量检索）——
# 方案一：Cloudflare Workers AI（每天免费 10,000 Neurons，bge-m3 足够个人用）
# EMBED_PROTOCOL=cloudflare
# EMBED_BASE_URL=https://api.cloudflare.com/client/v4
# EMBED_API_KEY=<Cloudflare API Token>
# CF_ACCOUNT_ID=<Cloudflare 账户 ID>
# EMBED_MODEL=@cf/baai/bge-m3
#
# 方案二：OpenAI 兼容接口（如硅基流动；DeepSeek 本身没有 embedding）
# EMBED_BASE_URL=https://api.siliconflow.cn/v1
# EMBED_API_KEY=
# EMBED_MODEL=BAAI/bge-m3

# —— Syncthing（可选，--profile sync）——
# NAS 上已有 Syncthing 时，换一组端口避免冲突
# SYNCTHING_GUI_PORT=8384
# SYNCTHING_SYNC_PORT=22000
# Syncthing 容器运行用户；笔记文件属主对不上时改这里
# PUID=1000
# PGID=1000

# —— Tailscale（可选，--profile vpn）——
# 首次授权 key：https://login.tailscale.com/admin/authkeys
TS_AUTHKEY=
# 设备在 Tailnet 里的主机名
# TS_HOSTNAME=neural-dashboard
# 需要设备标签时才填（普通 auth key 带标签参数会登录失败）
# TS_EXTRA_ARGS=--advertise-tags=tag:dashboard
