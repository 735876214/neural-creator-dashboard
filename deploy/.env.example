# 部署环境变量模板：复制到仓库根目录后填写（与 docker-compose.yml 同目录）
#   cp deploy/.env.example .env
# .env 已被 .gitignore 忽略，不要提交。
#
# .env 是可选的：docker compose 会自动读取 compose 文件所在目录（仓库根）的 .env
# 并填充 ${VAR}；没有 .env 也能启动（AI / 热点关闭）。下面所有未注释的变量都会生效；
# 注释掉的行表示使用服务端默认值。

# —— 基础（一般不用改）——
# HOST=0.0.0.0
# PORT=8787
# 看板对外端口（容器直接发布这个端口）；被占用时改成别的
# WEB_PORT=8088
# 端口绑定地址：默认所有网卡；前面挂 HTTPS 反代时改成 127.0.0.1（配合 TRUST_PROXY=1）
# WEB_BIND=0.0.0.0
# 容器进程的 uid/gid（容器内以 node 用户运行）：宿主上笔记目录属于别的用户时填成那边，
# 否则看板写出来的笔记在 SMB / Obsidian / 文件管理器里改不动也删不掉
# PUID=1000
# PGID=1000
# 请求体上限（字节），默认 4194304（4 MB）
# MAX_BODY=4194304
# vault 是 git 仓库时每次写入自动 commit（误写可回滚）；0 关闭
# VAULT_GIT=1
# 「今天是哪天」的时区偏移（作品日期、月目标进度、日报归类）。默认 8 = 北京时间。
# 注意：NEWS_TZ_OFFSET 只管日报生成时刻，这个才是看板日期基准。
# DASHBOARD_TZ_OFFSET=8
# 本机有反向代理（Caddy / Traefik / 群晖反代）时设 1，让 note-api 信任
# X-Forwarded-For / X-Forwarded-Proto。必须同时把 WEB_BIND 改成 127.0.0.1：
# 只在公网可达的端口上设它，任何请求都能自带 x-real-ip 伪造来源 IP、绕过登录限流。
# TRUST_PROXY=0

# —— 登录（必看）——
# 看板使用自己的登录页（login.html），用户名默认 admin。
# 密码留空 = 首次启动随机生成，用 `docker compose logs note-api` 查看；
# 想固定密码就填在这里（改完执行 docker compose up -d --force-recreate note-api）。
DASHBOARD_USER=admin
DASHBOARD_PASSWORD=
# 登录状态保留天数（Cookie）
# SESSION_DAYS=30

# API_TOKEN 只增不减能力：设置后 curl / 脚本可以用 Authorization: Bearer <token> 调 /api，
# 浏览器看板的会话不受影响（鉴权先试 token，失败再回落 Cookie）。想彻底关掉密码登录是另一回事，
# 请改 DASHBOARD_PASSWORD。
# API_TOKEN=

# —— AI（可选）——
# 不填 AI_API_KEY = 看板没有 AI 区块，其余功能全部正常。
# chat 模型（DeepSeek / 通义兼容模式 / Kimi / 硅基流动 / 自建网关…）
AI_API_KEY=
AI_BASE_URL=https://api.deepseek.com/v1
AI_MODEL=deepseek-chat

# 协议：openai（默认）或 anthropic（走 Anthropic 兼容网关）
# AI_PROTOCOL=openai
# 单次调用超时（毫秒）与并发数
# AI_TIMEOUT=60000
# AI_CONCURRENCY=4

# 各任务可用单独的模型（缺省回落 AI_MODEL）：
# AI_MODEL_ASK=        问答
# AI_MODEL_ANALYZE=    打标签 + 摘要
# AI_MODEL_IDEAS=      选题生成
# AI_MODEL_NEWS=       AI 热点日报
# 前端对话框里也可以随时手动切换模型（选择写在 NAS 的 vault/.dashboard/settings.json）

# —— 网页剪藏（第七星座：个人知识库）——
# 抓取网页的超时（毫秒）与响应体上限（字节）；剪藏页面会存 HTML 快照到 06-个人知识库/.snapshots/
# WEB_FETCH_TIMEOUT=20000
# WEB_FETCH_MAX_BYTES=2097152
# JS 渲染的页面（SPA）抓到的只是空壳，正文可能为空；静态文章页与多数推文页没有问题。
# AI 助手上传文件的上限即 MAX_BODY（默认 4 MB），
# 支持 md / txt / docx / pdf（PDF 解析用 pdfjs-dist，纯 JS；docx 为内置 zip 解析，零依赖）。

# —— AI 热点（第六星座）：消费现成 RSS 源 + AI 汇总，每天一份 ——
# RSS 源（默认 AIHOT 的「全部 AI 动态」）
# NEWS_SOURCE=https://aihot.news/feed/all.xml
# 当天几点之后开始生成（0–23，默认 8）
NEWS_HOUR=8
# 设为 0 关闭定时任务
# NEWS_CRON=0

# —— 平台指标同步（发布来源回链，可选）——
# 仅公众号支持自动拉取阅读数据：需要 WECHAT_APPID / WECHAT_SECRET；
# 其他平台（小红书 / 抖音 / B站）在看板的作品面板手动补填指标。
# WECHAT_APPID=
# WECHAT_SECRET=
# 每天几点之后自动同步（默认 21）；PLATFORM_SYNC_CRON=0 关闭
# SYNC_HOUR=21

# —— embedding（语义关联与向量检索）——
# 方案一：Cloudflare Workers AI（每天免费 10,000 Neurons，bge-m3 足够个人用）
# EMBED_PROTOCOL=cloudflare
# EMBED_BASE_URL=https://api.cloudflare.com/client/v4
# EMBED_API_KEY=<Cloudflare API Token>
# CF_ACCOUNT_ID=<Cloudflare 账户 ID>
# EMBED_MODEL=@cf/baai/bge-m3
#
# 方案二：OpenAI 兼容接口（如硅基流动；DeepSeek 本身没有 embedding）
# EMBED_BASE_URL=https://api.siliconflow.cn/v1
# EMBED_API_KEY=
# EMBED_MODEL=BAAI/bge-m3
